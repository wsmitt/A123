<!DOCTYPE html>
<html lang="af">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eks lief vir jou Anna</title>
  <style>
    body {
      background: linear-gradient(to right, #ffc0cb, #ffffff);
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .container {
      text-align: center;
      border: 4px solid #ff69b4;
      padding: 30px;
      border-radius: 15px;
      background-color: rgba(255, 255, 255, 0.8);
      box-shadow: 0 0 20px rgba(255, 105, 180, 0.4);
      animation: pulse 2s infinite;
      max-width: 90%;
    }

    h1 {
      font-size: 2em;
      margin: 0;
      color: #d6336c;
    }

    .heart {
      display: inline-block;
      font-size: 2.5em;
      animation: grow 1s infinite alternate;
    }

    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.05); }
      100% { transform: scale(1); }
    }

    @keyframes grow {
      0% { transform: scale(1); }
      100% { transform: scale(1.2); }
    }
  </style>
</head>
<body>
  <div class="container" role="main">
    <h1>Eks lief vir jou Anna <span class="heart" aria-label="hart">❤️</span></h1>
  </div>
</body>
</html>
